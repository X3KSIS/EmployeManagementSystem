@inherits LayoutComponentBase
@implements IDisposable
@inject ISnackbar Snackbar
@inject IAppSettingsService Settings

<MudThemeProvider Theme="_theme" IsDarkMode="_settings.DarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" Class="ems-drawer">
        <div class="d-flex flex-column" style="height:100%;">
            <div class="ems-brand">
                <MudIcon Icon="@Icons.Material.Filled.Layers" Style="color:#2f80ff; font-size:2.2rem;" />
                <span>EMS</span>
            </div>

            <div class="flex-grow-1">
                <NavMenu />
            </div>

            <div class="ems-drawer-footer">
                <MudAvatar Color="Color.Primary" Size="Size.Medium">AU</MudAvatar>
                <div>
                    <div class="ems-footer-name">Admin User</div>
                    <div class="ems-footer-mail">admin@bangison.com</div>
                </div>
            </div>
        </div>
    </MudDrawer>

    <MudAppBar Elevation="0" Class="ems-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" Class="d-md-none" />
        <div>
            <MudText Typo="Typo.h6" Class="font-weight-bold">@_settings.CompanyName</MudText>
            @if (!string.IsNullOrEmpty(_settings.WelcomeMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_settings.WelcomeMessage</MudText>
            }
        </div>
        <MudSpacer />
    </MudAppBar>

    <MudMainContent Class="ems-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private AppSettings _settings = new();

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1565f0",
            Secondary = "#6b7a90",
            Background = "#f4f6fa",
            Surface = "#ffffff",
            AppbarBackground = "#ffffff",
            AppbarText = "#0b1b3a",
            TextPrimary = "#0b1b3a",
            TextSecondary = "#6b7a90",
            DrawerBackground = "#071a3d",
            DrawerText = "rgba(255,255,255,0.85)",
            DrawerIcon = "rgba(255,255,255,0.85)"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#5b9bff",
            Secondary = "#90a4b8",
            Background = "#0b1526",
            Surface = "#12213a",
            AppbarBackground = "#12213a",
            AppbarText = "#e8eef7",
            TextPrimary = "#e8eef7",
            TextSecondary = "#90a4b8",
            DrawerBackground = "#071a3d",
            DrawerText = "rgba(255,255,255,0.85)",
            DrawerIcon = "rgba(255,255,255,0.85)"
        },
        LayoutProperties = new LayoutProperties
        {
            DrawerWidthLeft = "240px",
            DefaultBorderRadius = "8px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = new[] { "Inter", "Helvetica", "Arial", "sans-serif" } }
        }
    };

    protected override void OnInitialized()
    {
        // Already loaded at startup, so the first render has the saved theme and name (no light-mode flash).
        _settings = Settings.Current;
        Settings.OnChange += HandleSettingsChanged;
    }

    // The service is shared by every open tab, so a save from any of them lands here,
    // possibly on another circuit's thread: InvokeAsync moves it onto this one.
    private void HandleSettingsChanged() => _ = InvokeAsync(() =>
    {
        _settings = Settings.Current;
        StateHasChanged();
    });

    public void Dispose() => Settings.OnChange -= HandleSettingsChanged;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void Logout() =>
        Snackbar.Add("Authentication is not implemented yet.", Severity.Info);
}