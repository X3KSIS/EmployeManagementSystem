@inject ISnackbar Snackbar
<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">
        Dashboard
    </MudNavLink>

    
    <MudNavGroup Title="Employees" 
                Icon="@Icons.Material.Outlined.People" 
                Expanded="true"> 
        <MudNavLink Href="/employees" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.People">
            All Employees
        </MudNavLink>
        <MudNavLink Href="/employees/add" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.PersonAdd">
            Add Employee
        </MudNavLink>
    </MudNavGroup>

    <MudNavLink Href="/departments" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Business">
        Departments
    </MudNavLink>


    <MudNavGroup Title="More" Icon="@Icons.Material.Outlined.MoreHoriz" Expanded="false">

    <MudNavLink OnClick="OnReportsClick"
                Icon="@Icons.Material.Outlined.Description">
        Reports
    </MudNavLink>

    <MudNavLink OnClick="OnSettingsClick"
                Icon="@Icons.Material.Outlined.Settings">
        Settings
    </MudNavLink>

</MudNavGroup>
</MudNavMenu>

@code{
    private void OnReportsClick()
    {
        Snackbar.Add("Reports is not implemented yet.", Severity.Info);
    }
    private void OnSettingsClick()
    {
        Snackbar.Add("Settings is not implemented yet.", Severity.Info);
    }
}