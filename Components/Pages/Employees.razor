@page "/employees"
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject ISnackbar Snackbar

<PageTitle>EMS | All Employees</PageTitle>

<MudText Typo="Typo.h4" Class="font-weight-bold mb-4">All Employees</MudText>

@* Summary cards: total employees + average salary *@
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6">
        <StatCard Title="Total Employees" Value="@_stats.TotalCount.ToString()"
                  Icon="@Icons.Material.Filled.People" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <StatCard Title="Average Salary" Value="@Formatters.Money(_stats.AverageSalary)"
                  Icon="@Icons.Material.Filled.Payments" IconColor="Color.Success" />
    </MudItem>
</MudGrid>

@* Toolbar: search, department filter, sort, add button *@
<MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged"
                  Immediate="true" DebounceInterval="300"
                  Placeholder="Search employee..." Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Style="min-width:280px; background:#fff;" />

    <MudSelect T="int?" Value="_departmentId" ValueChanged="OnDepartmentChanged"
               ToStringFunc="DepartmentName"
               Label="Department" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
               Style="min-width:200px; background:#fff;">
        @foreach (var dept in _departments)
        {
            <MudSelectItem T="int?" Value="@dept.Id">@dept.Name</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="EmployeeStatus?" Value="_status" ValueChanged="OnStatusChanged"
               ToStringFunc="StatusName"
               Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense"
               Style="min-width:160px; background:#fff;">
        <MudSelectItem T="EmployeeStatus?" Value="@((EmployeeStatus?)null)">All</MudSelectItem>
        @foreach (var status in Enum.GetValues<EmployeeStatus>())
        {
            <MudSelectItem T="EmployeeStatus?" Value="@status">@Formatters.StatusText(status)</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="EmployeeSortOption" Value="_sort" ValueChanged="OnSortChanged"
               Label="Sort by" Variant="Variant.Outlined" Margin="Margin.Dense"
               Style="min-width:200px; background:#fff;">
        <MudSelectItem T="EmployeeSortOption" Value="EmployeeSortOption.NameAsc">Name (A–Z)</MudSelectItem>
        <MudSelectItem T="EmployeeSortOption" Value="EmployeeSortOption.NameDesc">Name (Z–A)</MudSelectItem>
        <MudSelectItem T="EmployeeSortOption" Value="EmployeeSortOption.SalaryAsc">Salary (low to high)</MudSelectItem>
        <MudSelectItem T="EmployeeSortOption" Value="EmployeeSortOption.SalaryDesc">Salary (high to low)</MudSelectItem>
    </MudSelect>

    <MudSpacer />

    @if (_selected.Count > 0)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                   OnClick="@(() => _confirmBulkDelete = true)">
            Delete selected (@_selected.Count)
        </MudButton>
    }

    <MudButton Href="/employees/add" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add">Add New Employee</MudButton>
</MudStack>

<MudPaper Outlined="true" Class="rounded-lg ems-table">
    @* Checkboxes only (no row-click selection) so clicking the actions menu doesn't toggle the row.
       The header checkbox selects every row on the current page. *@
    <MudTable T="Employee" Items="_result.Items" Hover="true" Elevation="0" Loading="_loading"
              Breakpoint="Breakpoint.Sm"
              MultiSelection="true" SelectOnRowClick="false"
              @bind-SelectedItems="_selected">
        <HeaderContent>
            <MudTh>Employee Name</MudTh>
            <MudTh>Department</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Salary</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Employee Name">
                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                    <EmployeeAvatar Initials="@context.Initials" ColorSeed="@context.Id" />
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@context.FullName</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@context.JobTitle</MudText>
                    </div>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Department">@context.Department?.Name</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Salary">@Formatters.Money(context.Salary)</MudTd>
            <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
            <MudTd DataLabel="Actions">
    <MudMenu Dense="true"
             AnchorOrigin="Origin.BottomRight"
             TransformOrigin="Origin.TopRight">
        <ActivatorContent>
            <MudIconButton Icon="@Icons.Material.Filled.MoreHoriz"
                           Size="Size.Small"
                           Color="Color.Default"
                           Variant="Variant.Text" />
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Icon="@Icons.Material.Outlined.Visibility"
                         Href="@($"/employees/{context.Id}")">
                View
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Edit"
                         Href="@($"/employees/edit/{context.Id}")">
                Edit
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Delete"
                         IconColor="Color.Error"
                         OnClick="@(() => AskToDelete(context))">
                Delete
            </MudMenuItem>
        </ChildContent>
    </MudMenu>
</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-6" Color="Color.Secondary">No employees match your search or filter.</MudText>
        </NoRecordsContent>
    </MudTable>

    @* Server-side pager: only the current page is loaded from the database. *@
    <MudDivider />
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween" Class="pa-3">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @if (_result.TotalCount == 0)
            {
                @:No matching employees
            }
            else
            {
                @($"Showing {_result.FirstItemNumber}–{_result.LastItemNumber} of {_result.TotalCount}")
                @(_result.TotalCount == 1 ? " employee" : " employees")
            }
        </MudText>

        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
            <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged"
                       Label="Rows per page" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Style="width:130px;">
                @foreach (var size in PageSizeOptions)
                {
                    <MudSelectItem T="int" Value="@size">@size</MudSelectItem>
                }
            </MudSelect>

            <MudPagination Count="_result.PageCount" Selected="_result.Page" SelectedChanged="OnPageChanged"
                           Color="Color.Primary" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true"
                           Disabled="_loading" />
        </MudStack>
    </MudStack>
</MudPaper>

<ConfirmDialog Visible="@(_employeeToDelete is not null)"
               Title="Delete employee?"
               Message="@($"This will permanently remove {_employeeToDelete?.FullName}. This cannot be undone.")"
               OnConfirm="DeleteConfirmedAsync"
               OnCancel="CancelDelete" />

<ConfirmDialog Visible="_confirmBulkDelete"
               Title="@($"Delete {_selected.Count} {(_selected.Count == 1 ? "employee" : "employees")}?")"
               Message="@BulkDeleteMessage"
               ConfirmText="@($"Delete {_selected.Count}")"
               OnConfirm="DeleteSelectedAsync"
               OnCancel="@(() => _confirmBulkDelete = false)" />

@code {
    private static readonly int[] PageSizeOptions = { 5, 10, 25, 50 };

    private PagedResult<Employee> _result = new(Array.Empty<Employee>(), 0, 1, 10);
    private int _page = 1;
    private int _pageSize = 10;
    private EmployeeStats _stats = new(0, 0m, 0, 0);

    private string? _search;
    private int? _departmentId;
    private EmployeeStatus? _status;
    private IReadOnlyList<Department> _departments = Array.Empty<Department>();
    private EmployeeSortOption _sort = EmployeeSortOption.NameAsc;

    private bool _loading = true;
    private Employee? _employeeToDelete;

    private HashSet<Employee> _selected = new();
    private bool _confirmBulkDelete;

    protected override async Task OnInitializedAsync()
    {
        _departments = await DepartmentService.GetAllAsync();
        await LoadAsync();
    }

    private string DepartmentName(int? id) => _departments.FirstOrDefault(d => d.Id == id)?.Name ?? string.Empty;

    private async Task LoadAsync()
    {
        _loading = true;
        // Rows are new objects after every reload, so the old selection would point at stale rows.
        // Clearing it also guarantees nothing hidden on another page or behind a filter gets deleted.
        _selected = new HashSet<Employee>();
        _result = await EmployeeService.GetEmployeesAsync(new EmployeeFilter(
            Search: _search,
            DepartmentId: _departmentId,
            Status: _status,
            Sort: _sort,
            Page: _page,
            PageSize: _pageSize));
        _page = _result.Page; // the service may move us back if the page no longer exists
        _stats = await EmployeeService.GetStatsAsync();
        _loading = false;
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnDepartmentChanged(int? value)
    {
        _departmentId = value;
        _page = 1;
        await LoadAsync();
    }

    private static string StatusName(EmployeeStatus? status)
        => status is EmployeeStatus s ? Formatters.StatusText(s) : "All";

    private async Task OnStatusChanged(EmployeeStatus? value)
    {
        _status = value;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSortChanged(EmployeeSortOption value)
    {
        _sort = value;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
        await LoadAsync();
    }

    private string BulkDeleteMessage
    {
        get
        {
            var names = _selected.OrderBy(e => e.FullName).Select(e => e.FullName).ToList();
            var shown = names.Count <= 5
                ? string.Join(", ", names)
                : $"{string.Join(", ", names.Take(5))} and {names.Count - 5} more";
            return $"This will permanently remove {shown}. This cannot be undone.";
        }
    }

    private async Task DeleteSelectedAsync()
    {
        _confirmBulkDelete = false;
        var requested = _selected.Count;
        if (requested == 0) return;

        var deleted = await EmployeeService.DeleteManyAsync(_selected.Select(e => e.Id));

        if (deleted == requested)
        {
            Snackbar.Add($"{deleted} {(deleted == 1 ? "employee was" : "employees were")} deleted.", Severity.Success);
        }
        else
        {
            // Someone else removed some of them first.
            Snackbar.Add($"{deleted} of {requested} employees were deleted; the rest no longer existed.", Severity.Warning);
        }

        await LoadAsync(); // refreshes the list, the pager and the summary cards; clears the selection
    }

    private void AskToDelete(Employee employee) => _employeeToDelete = employee;

    private void CancelDelete() => _employeeToDelete = null;

    private async Task DeleteConfirmedAsync()
    {
        if (_employeeToDelete is null) return;

        var name = _employeeToDelete.FullName;
        var deleted = await EmployeeService.DeleteAsync(_employeeToDelete.Id);
        _employeeToDelete = null;

        Snackbar.Add(deleted ? $"{name} was deleted." : "Employee could not be found.",
                     deleted ? Severity.Success : Severity.Warning);

        await LoadAsync();
    }
}
