@page "/employees/edit/{Id:int}"
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>EMS | Edit Employee</PageTitle>

<MudText Typo="Typo.h4" Class="font-weight-bold mb-4">Edit Employee</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_employee is null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">Employee not found.</MudAlert>
    <MudButton Href="/employees" Variant="Variant.Outlined">Back to employees</MudButton>
}
else
{
    <MudPaper Outlined="true" Class="pa-6 rounded-lg">
        <EmployeeForm Model="_employee"
                      Departments="_departments"
                      SubmitText="Update Employee"
                      OnSubmit="SaveAsync"
                      OnCancel="GoBack" />
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }

    private Employee? _employee;
    private IReadOnlyList<Department> _departments = Array.Empty<Department>();
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _departments = await DepartmentService.GetAllAsync();
        _employee = await EmployeeService.GetByIdAsync(Id);
        _loading = false;
    }

    private async Task SaveAsync(Employee employee)
    {
        if (await EmployeeService.EmailExistsAsync(employee.Email, excludeEmployeeId: employee.Id))
        {
            Snackbar.Add("Another employee already uses this email.", Severity.Error);
            return;
        }

        var updated = await EmployeeService.UpdateAsync(employee);
        Snackbar.Add(updated ? $"{employee.FullName} was updated." : "Employee no longer exists.",
                     updated ? Severity.Success : Severity.Error);
        Navigation.NavigateTo("/employees");
    }

    private void GoBack() => Navigation.NavigateTo("/employees");
}
