@page "/reports"
@inject IDepartmentService DepartmentService
@inject IAppSettingsService Settings

<PageTitle>EMS | Reports</PageTitle>

<MudText Typo="Typo.h4" Class="font-weight-bold mb-4">Reports</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Outlined="true" Class="pa-4 rounded-lg mb-4">
        <MudText Typo="Typo.h6" Class="font-weight-bold">Employees per department</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            @TotalEmployees @(TotalEmployees == 1 ? "employee" : "employees") across
            @_summaries.Count @(_summaries.Count == 1 ? "department" : "departments")
        </MudText>
        <DepartmentHeadcountChart Summaries="_summaries" Height="360px" />
    </MudPaper>

    @* The same numbers as a table, in the chart's order (largest first). *@
    <MudPaper Outlined="true" Class="rounded-lg ems-table">
        <MudTable T="DepartmentSummary" Items="_ordered" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm"
                  Dense="Settings.Current.IsCompact">
            <HeaderContent>
                <MudTh>Department</MudTh>
                <MudTh Style="text-align:right">Employees</MudTh>
                <MudTh Style="text-align:right">Average Salary</MudTh>
                <MudTh Style="text-align:right">Total Payroll</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Department">@context.Name</MudTd>
                <MudTd DataLabel="Employees" Style="text-align:right">@context.EmployeeCount</MudTd>
                <MudTd DataLabel="Average Salary" Style="text-align:right">@Formatters.Money(context.AverageSalary)</MudTd>
                <MudTd DataLabel="Total Payroll" Style="text-align:right">@Formatters.Money(context.TotalPayroll)</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd Class="font-weight-bold">Total</MudTd>
                <MudTd Class="font-weight-bold" Style="text-align:right">@TotalEmployees</MudTd>
                <MudTd />
                <MudTd Class="font-weight-bold" Style="text-align:right">@Formatters.Money(_summaries.Sum(s => s.TotalPayroll))</MudTd>
            </FooterContent>
        </MudTable>
    </MudPaper>
}

@code {
    private IReadOnlyList<DepartmentSummary> _summaries = Array.Empty<DepartmentSummary>();
    private IReadOnlyList<DepartmentSummary> _ordered = Array.Empty<DepartmentSummary>();
    private bool _loading = true;

    private int TotalEmployees => _summaries.Sum(s => s.EmployeeCount);

    protected override async Task OnInitializedAsync()
    {
        _summaries = await DepartmentService.GetSummariesAsync();
        _ordered = _summaries.OrderByDescending(s => s.EmployeeCount).ThenBy(s => s.Name).ToList();
        _loading = false;
    }
}
